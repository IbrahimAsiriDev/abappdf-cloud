CLASS zcl_abappdf_demo DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC.

  PUBLIC SECTION.
    INTERFACES if_oo_adt_classrun.

    "! Prints one travel from /DMO/TRAVEL with the demo form ZPDF_TRAVEL.
    CLASS-METHODS print
      IMPORTING
        iv_doc        TYPE string DEFAULT '00000001'
      RETURNING
        VALUE(rv_pdf) TYPE xstring
      RAISING
        zcx_abappdf.

    "! The demo form ZPDF_TRAVEL as built in the designer (forms/ZPDF_TRAVEL.xml).
    "! Generated by tools/gen_demo_form.py; do not edit by hand.
    CLASS-METHODS template
      RETURNING
        VALUE(rs_template) TYPE zcl_abappdf_forms=>ty_template.

    "! The Arabic demo form ZPDF_TRAVEL_AR (forms/ZPDF_TRAVEL_AR.xml).
    "! Generated by tools/gen_demo_form.py; do not edit by hand.
    CLASS-METHODS template_ar
      RETURNING
        VALUE(rs_template) TYPE zcl_abappdf_forms=>ty_template.

    "! Built-in copy of a demo form, or nothing for another form id.
    CLASS-METHODS template_of
      IMPORTING
        iv_form_id         TYPE string
      RETURNING
        VALUE(rs_template) TYPE zcl_abappdf_forms=>ty_template.

    "! Puts the demo forms into the form store once per client, so a fresh install
    "! shows them in the designer. A demo form the user deletes later stays deleted.
    CLASS-METHODS seed_once.

    "! Creates the demo forms in the form store when they have no active version.
    CLASS-METHODS ensure_form
      RAISING
        zcx_abappdf.

  PRIVATE SECTION.
    CONSTANTS c_form_id TYPE string VALUE zcl_abappdf_config=>demo_form_id.

    CLASS-METHODS ensure_one
      IMPORTING
        iv_form_id     TYPE string
        iv_description TYPE string
      RAISING
        zcx_abappdf.
ENDCLASS.



CLASS zcl_abappdf_demo IMPLEMENTATION.

  METHOD if_oo_adt_classrun~main.
    DATA lv_pdf TYPE xstring.
    DATA lv_sig TYPE x LENGTH 4 VALUE zcl_abappdf_config=>pdf_signature.

    TRY.
        lv_pdf = print( ).
        COMMIT WORK.
        out->write( |Form: { c_form_id }| ).
        out->write( |PDF bytes: { xstrlen( lv_pdf ) }| ).
        IF xstrlen( lv_pdf ) >= 4 AND lv_pdf(4) = lv_sig.
          out->write( 'PDF signature: %PDF' ).
        ELSE.
          out->write( 'PDF signature missing' ).
        ENDIF.
        out->write( 'Open /sap/bc/http/sap/zabappdf_http/print/<travel id> on this system' ).
      CATCH zcx_abappdf INTO DATA(lx_pdf).
        out->write( |Print failed: { lx_pdf->get_text( ) }| ).
    ENDTRY.
  ENDMETHOD.


  METHOD print.
    DATA lr_data TYPE REF TO data.
    FIELD-SYMBOLS <data> TYPE any.

    ensure_form( ).
    lr_data = zcl_abappdf_json=>to_abap( zcl_abappdf_travel=>build( iv_key = iv_doc ) ).
    ASSIGN lr_data->* TO <data>.
    rv_pdf = zcl_abappdf_api=>render_pdf(
      iv_form_id = c_form_id
      is_data    = <data> ).
  ENDMETHOD.


  METHOD seed_once.
    "DEMO_SEEDED lists the demo forms already added, so a demo form that a later
    "release adds still arrives, and one the user deleted is not added again.
    DATA lv_done TYPE string.
    DATA lv_list TYPE string.
    lv_done = zcl_abappdf_forms=>get_config( zcl_abappdf_config=>param_demo_seeded ).
    IF lv_done = 'X'.
      lv_done = zcl_abappdf_config=>demo_form_id.
    ENDIF.
    lv_list = |,{ lv_done },|.
    IF lv_list CS |,{ zcl_abappdf_config=>demo_form_id },| AND lv_list CS |,{ zcl_abappdf_config=>demo_form_id_ar },|.
      RETURN.
    ENDIF.
    TRY.
        IF lv_list NS |,{ zcl_abappdf_config=>demo_form_id },|.
          ensure_one(
            iv_form_id     = zcl_abappdf_config=>demo_form_id
            iv_description = 'Travel demo for the RAP app ZC_ABAPPDF_TRAVEL' ).
          lv_done = COND #( WHEN lv_done IS INITIAL THEN zcl_abappdf_config=>demo_form_id
                            ELSE |{ lv_done },{ zcl_abappdf_config=>demo_form_id }| ).
        ENDIF.
        IF lv_list NS |,{ zcl_abappdf_config=>demo_form_id_ar },|.
          ensure_one(
            iv_form_id     = zcl_abappdf_config=>demo_form_id_ar
            iv_description = `Arabic travel demo (right to left)` ).
          lv_done = COND #( WHEN lv_done IS INITIAL THEN zcl_abappdf_config=>demo_form_id_ar
                            ELSE |{ lv_done },{ zcl_abappdf_config=>demo_form_id_ar }| ).
        ENDIF.
        zcl_abappdf_forms=>set_config(
          iv_param = zcl_abappdf_config=>param_demo_seeded
          iv_value = lv_done ).
      CATCH zcx_abappdf.
        "The designer still opens; the next visit tries again.
    ENDTRY.
  ENDMETHOD.


  METHOD ensure_form.
    ensure_one(
      iv_form_id     = zcl_abappdf_config=>demo_form_id
      iv_description = 'Travel demo for the RAP app ZC_ABAPPDF_TRAVEL' ).
    ensure_one(
      iv_form_id     = zcl_abappdf_config=>demo_form_id_ar
      iv_description = `Arabic travel demo (right to left)` ).
  ENDMETHOD.


  METHOD ensure_one.
    TRY.
        zcl_abappdf_forms=>read_active( iv_form_id ).
        RETURN.
      CATCH zcx_abappdf.
    ENDTRY.
    TRY.
        zcl_abappdf_forms=>create_form(
          iv_form_id     = iv_form_id
          iv_description = iv_description
          iv_package     = zcl_abappdf_config=>local_package ).
      CATCH zcx_abappdf.
        "The form exists without a template version; save_version adds one.
    ENDTRY.
    zcl_abappdf_forms=>save_version( template_of( iv_form_id ) ).
  ENDMETHOD.


  METHOD template_of.
    CASE to_upper( iv_form_id ).
      WHEN zcl_abappdf_config=>demo_form_id.
        rs_template = template( ).
      WHEN zcl_abappdf_config=>demo_form_id_ar.
        rs_template = template_ar( ).
    ENDCASE.
  ENDMETHOD.


